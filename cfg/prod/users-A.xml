<!-- 档 A：每节点 4 vCPU / 16 GB。生产 default profile 里随规格变的几项：并行度钉在 vCPU 数，并发上限按规格给。 -->
<clickhouse>
    <profiles>
        <default>
            <max_threads>4</max_threads>
            <max_concurrent_queries_for_all_users>100</max_concurrent_queries_for_all_users>   <!-- 整个服务的并发到这个数，新查询（含 INSERT）就被拒；CONST，见 users.xml -->
            <constraints>
                <max_threads><min>1</min><max>4</max></max_threads>
                <max_insert_threads><min>1</min><max>4</max></max_insert_threads>
            </constraints>
        </default>
    </profiles>
</clickhouse>
